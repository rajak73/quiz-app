# MongoDB Connection String (Get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/quiz-app?retryWrites=true&w=majority

# JWT Secret Key (Generate a random string)
JWT_SECRET=your_super_secret_jwt_key_here

# JWT expiry (optional, defaults to 7d)
JWT_EXPIRE=7d

# Frontend URL (Update after deploying frontend) - also used to build the CSP allow-list
FRONTEND_URL=https://your-app-name.netlify.app

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# Google Sign-In (OAuth Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Email Configuration (used for password-reset emails via Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
